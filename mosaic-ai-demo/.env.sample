# Databricks Mosaic AI Demo - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# REQUIRED: Databricks Workspace Configuration
# ============================================================================

# Your Databricks workspace URL
# Format examples:
#   AWS:   https://<workspace-id>.cloud.databricks.com
#   Azure: https://adb-<workspace-id>.<random>.azuredatabricks.net
#   GCP:   https://<workspace-id>.gcp.databricks.com
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# Your Databricks Personal Access Token (PAT)
# Generate at: User Settings → Developer → Access Tokens → Generate New Token
# Keep this secret and never commit it to version control!
DATABRICKS_TOKEN=your_databricks_token_here


# ============================================================================
# OPTIONAL: Catalog and Schema Configuration
# ============================================================================

# Unity Catalog name (default: main)
DATABRICKS_CATALOG=main

# Schema/Database name (default: default)
DATABRICKS_SCHEMA=default


# ============================================================================
# OPTIONAL: Model Serving Configuration
# ============================================================================

# Default model endpoint for queries
# Available models:
#   - databricks-llama-3-1-8b-instruct (cheapest, fastest)
#   - databricks-llama-3-3-70b-instruct (balanced)
#   - databricks-llama-3-1-405b-instruct (most capable)
#   - databricks-mixtral-8x7b-instruct
#   - databricks-dbrx-instruct
DEFAULT_MODEL=databricks-llama-3-1-8b-instruct


# ============================================================================
# OPTIONAL: Vector Search Configuration
# ============================================================================

# Vector Search endpoint name
VECTOR_SEARCH_ENDPOINT=your_vector_search_endpoint

# Vector Search index name (format: catalog.schema.index_name)
VECTOR_INDEX_NAME=main.default.docs_index

# Embedding model endpoint for Vector Search
EMBEDDING_MODEL_ENDPOINT=databricks-bge-large-en


# ============================================================================
# OPTIONAL: AI Gateway Configuration
# ============================================================================

# AI Gateway route name (default: default)
DATABRICKS_GATEWAY_ROUTE=default

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=10

# Enable PII masking (true/false)
ENABLE_PII_MASKING=true

# Enable toxicity filtering (true/false)
ENABLE_TOXICITY_FILTER=true


# ============================================================================
# OPTIONAL: RAG Pipeline Configuration
# ============================================================================

# Number of context chunks to retrieve for RAG
RAG_NUM_CONTEXT_CHUNKS=3

# Document chunking size (characters)
RAG_CHUNK_SIZE=500

# Document chunking overlap (characters)
RAG_CHUNK_OVERLAP=50

# Temperature for generation (0.0 to 1.0)
RAG_TEMPERATURE=0.3


# ============================================================================
# OPTIONAL: Logging and Monitoring
# ============================================================================

# MLflow tracking URI (leave empty to use workspace default)
MLFLOW_TRACKING_URI=

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO


# ============================================================================
# NOTES
# ============================================================================
#
# 1. NEVER commit the .env file with actual credentials to version control
# 2. The .env file should be listed in .gitignore
# 3. Generate your Personal Access Token with appropriate permissions:
#    - Workspace access
#    - SQL access (for Vector Search)
#    - Serving access (for Model Serving)
# 4. Token expiration: Set an appropriate expiration date for your token
# 5. For production use, consider using Databricks Service Principals instead of PATs
#
# ============================================================================
